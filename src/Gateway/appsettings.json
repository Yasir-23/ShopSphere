{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://localhost:15341"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed-window-ip",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "RateLimiterPolicy": "fixed-window-ip",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "RateLimiterPolicy": "fixed-window-ip",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/v1/basket/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "RateLimiterPolicy": "fixed-window-ip",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}"
        }
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "RateLimiterPolicy": "fixed-window-ip",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "fixed-window-ip",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://localhost:5005"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://localhost:5010"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket-destination": {
            "Address": "http://localhost:5020"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-destination": {
            "Address": "http://localhost:5030"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
