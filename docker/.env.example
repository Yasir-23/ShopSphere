# Microsoft SQL Server 2022
SQLSERVER_PORT=11433
MSSQL_SA_PASSWORD=ShopSphere_Dev_2026!

# PostgreSQL 16
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ShopSphere_Postgres_2026!
POSTGRES_DB=shopsphere_inventory

# MongoDB 7.0
MONGO_PORT=27018
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=ShopSphere_Mongo_2026!

# Redis 7.2
REDIS_PORT=16379

# RabbitMQ 3.13
RABBITMQ_PORT=15672
RABBITMQ_MGMT_PORT=25672
RABBITMQ_DEFAULT_USER=shopsphere
RABBITMQ_DEFAULT_PASS=ShopSphere_RabbitMQ_2026!

# Datalust Seq
SEQ_PORT=15341
SEQ_INGESTION_PORT=15342

# Jaeger All-in-One
